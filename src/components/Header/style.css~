.nav {
    /*padding: 0px 8px;*/
    display: flex;
    background-color: rgba(255, 0, 0, 0.47);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

.nav-svg-container {
    max-width: 50px;
}

.nav-button-container {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-color: #ffffff31;
    border: none;
    padding: 10px;
    /*display: flex;*/
    /*align-items: center;*/
    /*justify-content: center;*/
}

.nav-button-container button {
    z-index: 10;
}

.nav-button-container:hover {
    cursor: pointer;
    background-color: greenyellow;
}

