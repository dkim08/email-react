.header-container {
    position: fixed;
    padding-left: 20px;
    height: 100vh;
}

.header {
    padding-top: 20px;
    background: linear-gradient(to top, rgb(33, 33, 33), rgb(66, 76, 65) );
    border-radius: 70px;
    width: 60px;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 20px;
}

.logo-container {
    display: flex;
    justify-content: center;
    /*width: 100%;*/
}

