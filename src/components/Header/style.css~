.header-container {
    position: fixed;
    padding-left: 20px;
    height: 100vh;
}

#expand-button-close {
    animation: rotateArrowReverse 0.3s ease-in-out;
    transform: rotate(0deg);
}

#expand-button-expanded{
    animation: rotateArrow 0.3s ease-in-out;
    transform: rotate(90deg);
}

@keyframes rotateArrow {
    from {
        transform: rotate(0deg);
    }
    to {
        transform: rotate(90deg);
    }
}

@keyframes rotateArrowReverse {
    from {
        transform: rotate(90deg);
    }
    to {
        transform: rotate(0deg);
    }
}

.header {
    padding-top: 20px;
    background: linear-gradient(to top, rgb(33, 33, 33), rgb(66, 76, 65) );
    border-radius: 70px;
    width: 60px;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 20px;
    transition: all 0.2s ease-in-out;
}

.mobile-header {
    padding-top: 20px;
    padding-bottom: 10px;
    background: linear-gradient(to top, rgb(33, 33, 33), rgb(66, 76, 65) );
    border-radius: 70px;
    width: 60px;
    max-height: 140px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 20px;
    transition: all 0.2s ease-in-out;
    overflow: hidden;
}

.mobile-header.expanded {
    max-height: 270px;
}

.logo-container {
    display: flex;
    justify-content: center;
}

.nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

.mobile-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

.nav-svg-container {
    max-width: 50px;
}

.nav-button-container {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #ffffff31;
    border: none;
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.nav-button-container button {
    z-index: 10;
}

.nav-button-container:hover,
.nav-button-container.active {
    cursor: pointer;
    background-color: rgb(145, 145, 145);
}

.mobile-arrow {
    /* margin: auto; */
    width: 100%;
    height: 100%;
    font-size: 50px;
    color: #fff;

}